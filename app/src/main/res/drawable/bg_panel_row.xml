<?xml version="1.0" encoding="utf-8"?>
<!-- Leanback side-panel row: transparent until focused, then a flat full-width
     highlight band (no corners, no border) matching the stock Android TV
     settings look on this device. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_row_focused" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
