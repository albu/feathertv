<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_midnight">

    <!-- Cinematic Backdrop Image -->
    <ImageView
        android:id="@+id/ivBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Dark Gradient Overlays for High Legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_backdrop_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_scrim" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingTop="36dp"
        android:paddingEnd="64dp"
        android:paddingBottom="36dp">

        <!-- Left: High-Res Poster Card -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="300dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_search_card"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/ivPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_poster_placeholder"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <!-- Right: Title, Metadata, Overview, and Watch Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Ted Lasso" />

            <!-- Tagline -->
            <TextView
                android:id="@+id/tvDetailTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="Kindness makes a comeback."
                tools:visibility="visible" />

            <!-- Metadata badges row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="2020" />

                <TextView
                    android:id="@+id/tvDetailRuntime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="2h 14m" />

                <TextView
                    android:id="@+id/tvDetailRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_rating"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="★ 8.4" />

                <TextView
                    android:id="@+id/tvDetailGenres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="Comedy · Drama · Sport" />
            </LinearLayout>

            <!-- Overview -->
            <TextView
                android:id="@+id/tvDetailOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                tools:text="Ted Lasso, an American college football coach, is hired to manage a British soccer team." />

            <!-- Watch / Action Header -->
            <TextView
                android:id="@+id/tvActionsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.08"
                android:text="@string/search_watch_options"
                android:textColor="@color/card_stroke_focused"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Loading status indicator -->
            <TextView
                android:id="@+id/tvDetailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/search_loading"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                tools:text="Checking availability…" />

            <!-- Action buttons container -->
            <LinearLayout
                android:id="@+id/detailProviderRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
