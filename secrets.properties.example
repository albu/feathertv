# TMDB API Key for movie & series posters/metadata search
# (Get a free API key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# (Optional) Local WiZ light strip IP address
WIZ_IP=192.168.1.100

# (Optional) Default streaming provider country code (e.g. US, GB, DE, FR)
SEARCH_REGION=US

# (Optional) Latitude and Longitude for solar circadian adaptive lighting (defaults to 51.5074, -0.1278)
CIRCADIAN_LAT=51.5074
CIRCADIAN_LON=-0.1278
